<UserControl x:Class="NewSystemCreationHelperModule.Views.NewSystemHelperPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:views="clr-namespace:NewSystemCreationHelperModule.Views"
             xmlns:utility="clr-namespace:Utility;assembly=Utility" 
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             xmlns:prism="http://prismlibrary.com/" xmlns:it="http://schemas.microsoft.com/xaml/behaviors"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="20*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <views:ShortCutsForm Grid.Row="0" Grid.RowSpan="1" Grid.ColumnSpan="2"/>
        <views:DragnDropDatasheet Grid.Row="1" Grid.RowSpan="13" Grid.Column="0" Grid.ColumnSpan="2"/>
    </Grid>
</UserControl>
