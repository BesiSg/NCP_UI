<UserControl x:Class="ReleaseOverallSyncHelper.Views.ReleaseOverallViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:local="clr-namespace:UI.Class;assembly=UIs"
             xmlns:vm="clr-namespace:ReleaseOverallSyncHelper.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:prism="http://prismlibrary.com/" xmlns:it="http://schemas.microsoft.com/xaml/behaviors" xmlns:views="clr-namespace:ReleaseOverallSyncHelper.Views"
			 x:Name="Root">
    <UserControl.Resources>
        <local:BindingProxy x:Key="VmProxy"
                            Data="{Binding}" />
    </UserControl.Resources>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="0.1*"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource FrameWithoutShadow}" Grid.Row="0" Grid.ColumnSpan="4" Grid.RowSpan="3">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="6*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Row="0" Grid.ColumnSpan="1"
            Content="Refresh" Style="{StaticResource Button_FrameMenu}"
            Command="{Binding StartCommand}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3"/>
                <Label Margin="10" Style="{StaticResource LB_ItemTitle}" Content="keyword" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="1"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="KeyUp">
                            <prism:InvokeCommandAction
                Command="{Binding SearchCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <ListBox x:Name="CfgList" ItemsSource="{Binding Collection}" Grid.Row="2" Grid.ColumnSpan="4" Grid.RowSpan="1"
                 DisplayMemberPath="Name">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseDoubleClick">
                            <prism:InvokeCommandAction
                Command="{Binding Data.OpenCfgCommand,
                                  Source={StaticResource VmProxy}}"
                CommandParameter="{Binding SelectedItem, ElementName=CfgList}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="ContextMenu">
                                <Setter.Value>

                                    <ContextMenu>

                                        <MenuItem Header="Open Path"
                                          Command="{Binding Data.OpenPathCommand,
                                                            Source={StaticResource VmProxy}}"
                                          CommandParameter="{Binding}" />

                                    </ContextMenu>

                                </Setter.Value>
                            </Setter>

                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>




        <TextBox Grid.Row="3" Grid.ColumnSpan="4" Text="{Binding CfgContent}"
         IsReadOnly="True"
         AcceptsReturn="True"
         AcceptsTab="True"
         TextWrapping="NoWrap"
         VerticalScrollBarVisibility="Auto"
         HorizontalScrollBarVisibility="Auto"
         FontFamily="Consolas"
         Margin="0,5,0,5"/>
        <DataGrid ItemsSource="{Binding UnitSelections}"
                BorderThickness="1"
                Grid.Row="5"
                Grid.ColumnSpan="4"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                SelectionMode="Extended"
                SelectionUnit="FullRow">
            <DataGrid.Columns>
                <!-- Select All Column -->
                <DataGridTemplateColumn Header="Clone" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected,
                                                  Mode=TwoWay,
                                                  UpdateSourceTrigger=PropertyChanged}"
                              HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Unit"
                            Binding="{Binding Unit}"
                            IsReadOnly="True"/>
                <DataGridTextColumn Header="Version"
                            Binding="{Binding Version}"
                            IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Folder"
                        Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Open" Style="{StaticResource Button_FrameMenu}"
                    Padding="5,2"
                    Command="{Binding DataContext.OpenCloneFolderCommand,
                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Button_FrameMenu}"
            Content="Clone"
            Command="{Binding CloneGitCommand}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Margin="0,5,5,5"/>
        <Button Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource Button_FrameMenu}"
            Content="Cancel Clone"
            Command="{Binding CancelCloneCommand}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Margin="5,5,0,5"/>
        <Button Grid.Row="6" Grid.ColumnSpan="1" Grid.Column="0" Style="{StaticResource Button_FrameMenu}"
            Content="Clear Msg"
            Command="{Binding ClearMessageCommand}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Margin="0,5,5,5"/>
        <TextBox Grid.Row="7" Grid.ColumnSpan="4" Text="{Binding Message}"
            IsReadOnly="True"
            AcceptsReturn="True"
            AcceptsTab="True"
            TextWrapping="NoWrap"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Auto"
            FontFamily="Consolas"/>
    </Grid>
</UserControl>
