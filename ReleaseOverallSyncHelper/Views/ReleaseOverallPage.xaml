<UserControl x:Class="ReleaseOverallSyncHelper.Views.ReleaseOverallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:local="clr-namespace:UI.Class;assembly=UIs"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             Width="1900" Height="935"
             xmlns:prism="http://prismlibrary.com/" xmlns:it="http://schemas.microsoft.com/xaml/behaviors" xmlns:views="clr-namespace:ReleaseOverallSyncHelper.Views"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width ="10*"/>
            <ColumnDefinition Width ="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40*"/>
            <RowDefinition Height="40*"/>
        </Grid.RowDefinitions>
        <Label Style="{StaticResource LB_ItemTitle}" Content="Network" Grid.Column="0" Grid.Row="0"/>
        <Label Style="{StaticResource LB_ItemTitle}" Content="Local" Grid.Column="1" Grid.Row="0"/>
        <Label Style="{StaticResource LB_ItemTitle}" Content="BitBucket (ReleaseOverall)" Grid.Column="2" Grid.Row="0"/>
        <Border Style="{StaticResource FrameWithShadow}" Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" Margin="4">
            <views:ReleaseOverallViewer DataContext="{Binding _remote}" />
        </Border>
        <Border Style="{StaticResource FrameWithShadow}" Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" Margin="4">
            <views:ReleaseOverallViewer DataContext="{Binding _local}"/>
        </Border>
        <Border Style="{StaticResource FrameWithShadow}" Grid.Row="1" Grid.Column="2" Grid.RowSpan="2" Margin="4">
            <views:ReleaseOverallViewerBitBucket/>
        </Border>
        <Border Style="{StaticResource FrameWithShadow}" Grid.Row="1" Grid.ColumnSpan="1" Grid.Column="3" Grid.RowSpan="1" Margin="4">
            <views:PatchDownloader/>
        </Border>
    </Grid>
</UserControl>
