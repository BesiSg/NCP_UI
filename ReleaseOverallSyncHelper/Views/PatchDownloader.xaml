<UserControl x:Class="ReleaseOverallSyncHelper.Views.PatchDownloader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:local="clr-namespace:UI.Class;assembly=UIs"
             xmlns:vm="clr-namespace:ReleaseOverallSyncHelper.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:prism="http://prismlibrary.com/" xmlns:it="http://schemas.microsoft.com/xaml/behaviors" xmlns:views="clr-namespace:ReleaseOverallSyncHelper.Views"  prism:ViewModelLocator.AutoWireViewModel="True"
			 x:Name="Root">
    <UserControl.Resources>
        <local:BindingProxy x:Key="VmProxy"
                            Data="{Binding}" />
    </UserControl.Resources>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0">
            <Button Height="28" Width="28" Margin="3" Style="{StaticResource Button_FrameMenu}" ToolTip="Import" Command="{Binding ImportDataCommand}">
                <Image Source="/Resource/Recipe_Load.png" Style="{StaticResource ImgBtn_W25H25}"/>
            </Button>
            <Button Height="28" Width="28" Margin="3" Style="{StaticResource Button_FrameMenu}" ToolTip="Save" Command="{Binding SaveDataCommand}">
                <Image Source="/Resource/Save_Icon.png" Style="{StaticResource ImgBtn_W25H25}"/>
            </Button>
        </StackPanel>
        <Label Style="{StaticResource LB_IconicTitle}" Content="Version" Grid.Column="0" Grid.Row="1"/>
        <TextBox Grid.Row="1" Grid.ColumnSpan="1" Grid.Column="1" Margin="2"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="KeyUp">
                    <prism:InvokeCommandAction
                Command="{Binding SearchCommand}" AutoEnable="False"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </TextBox>
        <ComboBox Grid.Row="1"
          Grid.Column="2" Grid.ColumnSpan="2"
          Margin="2"
          ItemsSource="{Binding Repositories}"
          SelectedItem="{Binding SelectedRepository}">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <prism:InvokeCommandAction
                Command="{Binding SearchCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </ComboBox>
        <Label Style="{StaticResource LB_IconicTitle}" Content="Tag" Grid.Column="0" Grid.Row="2"/>
        <TextBox IsReadOnly="True" Grid.Row="2" Grid.ColumnSpan="1" Grid.Column="1" Margin="2" Text="{Binding Tag}"/>
        <TextBox IsReadOnly="True" Grid.Row="2" Grid.ColumnSpan="1" Grid.Column="2" Margin="2" Text="{Binding CustBranch}" Background="{Binding BranchExist, Converter={StaticResource SearchResultToBrushConverter}}"/>
        <TextBox IsReadOnly="True" Grid.Row="2" Grid.ColumnSpan="1" Grid.Column="3" Margin="2" Text="{Binding Revision}" Background="{Binding TagExist, Converter={StaticResource SearchResultToBrushConverter}}"/>
        <Label Style="{StaticResource LB_IconicTitle}" Content="Clone Tag" Grid.Column="0" Grid.Row="3"/>
        <TextBox IsReadOnly="True" Grid.Row="3" Grid.ColumnSpan="1" Grid.Column="1" Margin="2" Text="{Binding NextTag}"/>
        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" Grid.RowSpan="2">
            <StackPanel Orientation="Horizontal">
                <RadioButton Width="50" Content="Auto"
                 IsChecked="{Binding SelectedPathMode,
                                     Converter={StaticResource EnumToBooleanConverter},
                                     ConverterParameter=AutoGenerated}" />
                <TextBox Width="320"
                 Margin="10,0,0,0"
                 Text="{Binding AutoPath}"
                 IsReadOnly="True" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <RadioButton Width="50" Content="User"
                     VerticalAlignment="Center"
                     IsChecked="{Binding SelectedPathMode,
                                         Converter={StaticResource EnumToBooleanConverter},
                                         ConverterParameter=UserDefine}" />

                <TextBox Width="320"
                 Margin="10,0,0,0"
                 Text="{Binding UserPath}"
                 IsEnabled="{Binding IsUserDefine}" />

                <Button Content="..."
                Margin="5,0,0,0"
                Command="{Binding BrowseFolderCommand}"
                IsEnabled="{Binding IsUserDefine}" />
            </StackPanel>
        </StackPanel>
        <Button Grid.Row="6"
            Content="Clone"
            Command="{Binding CloneGitCommand}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Margin="1"/>
        <Button Grid.Row="6" Grid.Column="1"
            Content="Cancel Clone"
            Command="{Binding CancelCloneCommand}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Margin="1"/>
        <Button Grid.Row="7" Grid.Column="1"
            Content="Open"
            Command="{Binding OpenFolderCommand}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Margin="1"/>
        <Button Grid.Row="7" Grid.ColumnSpan="1" Grid.Column="0"
            Content="Clear Msg"
            Command="{Binding ClearMessageCommand}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Margin="1"/>
        <TextBox Grid.Row="8" Grid.ColumnSpan="4" Grid.RowSpan="5" Text="{Binding Message}"
            IsReadOnly="True"
            AcceptsReturn="True"
            AcceptsTab="True"
            TextWrapping="NoWrap"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Auto"
            FontFamily="Consolas"
            Margin="0,0,0,5"/>
    </Grid>
</UserControl>
