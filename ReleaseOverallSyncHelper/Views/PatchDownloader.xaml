<UserControl x:Class="ReleaseOverallSyncHelper.Views.PatchDownloader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:local="clr-namespace:UI.Class;assembly=UIs"
             xmlns:vm="clr-namespace:ReleaseOverallSyncHelper.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:prism="http://prismlibrary.com/" xmlns:it="http://schemas.microsoft.com/xaml/behaviors" xmlns:views="clr-namespace:ReleaseOverallSyncHelper.Views"
			 x:Name="Root">
    <UserControl.Resources>
        <local:BindingProxy x:Key="VmProxy"
                            Data="{Binding}" />
    </UserControl.Resources>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        
        <Button Grid.Row="0" Grid.ColumnSpan="1"
            Content="Refresh"
            Command="{Binding StartCommand}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Margin="5"/>
        <Label Style="{StaticResource LB_IconicTitle}" Content="Key"/>
        <TextBox Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding CfgContent}"
         IsReadOnly="True"
         AcceptsReturn="True"
         AcceptsTab="True"
         TextWrapping="NoWrap"
         VerticalScrollBarVisibility="Auto"
         HorizontalScrollBarVisibility="Auto"
         FontFamily="Consolas"
         Margin="0,0,0,5"/>
        <DataGrid ItemsSource="{Binding UnitSelections}"
                BorderThickness="1"
                Grid.Row="4"
                Grid.ColumnSpan="2"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                SelectionMode="Extended"
                SelectionUnit="FullRow">
            <DataGrid.Columns>
                <!-- Select All Column -->
                <DataGridTemplateColumn Header="Clone" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected,
                                                  Mode=TwoWay,
                                                  UpdateSourceTrigger=PropertyChanged}"
                              HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Unit"
                            Binding="{Binding Unit}"
                            IsReadOnly="True"/>
                <DataGridTextColumn Header="Version"
                            Binding="{Binding Version}"
                            IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Folder"
                        Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Open"
                    Padding="5,2"
                    Command="{Binding DataContext.OpenCloneFolderCommand,
                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="3"
            Content="Clone"
            Command="{Binding CloneGitCommand}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Margin="5"/>
        <Button Grid.Row="3" Grid.Column="1"
            Content="Cancel Clone"
            Command="{Binding CancelCloneCommand}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Margin="5"/>
        <Button Grid.Row="5" Grid.ColumnSpan="1" Grid.Column="0"
            Content="Clear Msg"
            Command="{Binding ClearMessageCommand}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Margin="5"/>
        <TextBox Grid.Row="6" Grid.ColumnSpan="2" Text="{Binding Message}"
            IsReadOnly="True"
            AcceptsReturn="True"
            AcceptsTab="True"
            TextWrapping="NoWrap"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Auto"
            FontFamily="Consolas"
            Margin="0,0,0,5"/>
    </Grid>
</UserControl>
